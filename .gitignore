# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Data directories (preserve folder structure via .gitkeep)
!data/raw/.gitkeep
!data/processed/.gitkeep

# Large trained model artifacts and weights
models/*
!models/.gitkeep
*.pkl
*.joblib
*.h5
*.hdf5
*.onnx
*.pt
*.pth

# Generated outputs & evaluation figures
outputs/*
!outputs/.gitkeep
!outputs/*.md

# Environment variables, credentials, and secrets
.env
.env.*
*.env
*.pem
*.key
credentials.json
client_secrets.json

# Streamlit secrets & config
.streamlit/secrets.toml

# IDE and editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
scratch/

# Testing caches
.pytest_cache/
.coverage
htmlcov/
